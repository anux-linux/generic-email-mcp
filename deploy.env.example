# Copy to deploy.env (git-ignored) and edit. Read by scripts/gcp-*.sh and
# scripts/deploy.sh as plain KEY=value lines; it is never executed.
# Secrets do NOT belong here: the scripts refuse MAIL_PASSWORD,
# TOKEN_SIGNING_KEY, OAUTH_CLIENT_SECRET and AUTHORIZE_PASSWORD_HASH.
# Store them with scripts/gcp-secrets.sh.

# --- Google Cloud ---------------------------------------------------------------
PROJECT_ID=my-project-id
# europe-west1 (Belgium) is a Tier 1 region close to Strato's German data centres.
REGION=europe-west1
SERVICE=email-mcp
REPOSITORY=email-mcp
RUNTIME_SA_NAME=email-mcp-run

# --- automatic deploys from GitHub (scripts/gcp-github.sh) ---------------------------
# The repository, spelled exactly as GitHub does (case matters), and its
# numeric IDs: gh api repos/OWNER/REPO --jq '.id, .owner.id'
# CD_REPO=anux-linux/generic-email-mcp
# CD_REPO_ID=1427120410
# CD_OWNER_ID=838468
# Defaults:
# A pool used only for this service; gcp-github.sh refuses one holding
# any provider other than WIF_PROVIDER.
# WIF_POOL=email-mcp
# WIF_PROVIDER=github
# DEPLOY_SA_NAME=email-mcp-deploy

# --- service settings (plain environment variables; see README) -------------------
MAIL_USERNAME=you@your-domain.de
# MAIL_FROM_NAME=Your Name
# MAIL_IMAP_ADDR=imap.strato.de:993
# MAIL_SMTP_ADDR=smtp.strato.de:465
OAUTH_CLIENT_ID=claude-paste-the-id-from-gen-secrets
# Only these recipients (exact addresses or whole domains) can be sent to.
SEND_ALLOWLIST=you@your-domain.de
MAX_SENDS_PER_DAY=20
# Increase to revoke every issued token.
TOKEN_EPOCH=1
# basic (browser dialog) or form; see docs/VERIFY.md C1.
AUTHORIZE_LOGIN=basic
LOG_LEVEL=info
# Folder overrides if discovery picks wrong (docs/INSPECTOR.md B4):
# MAIL_FOLDER_SENT=
# MAIL_FOLDER_DRAFTS=
# MAIL_FOLDER_TRASH=
# MAIL_FOLDER_ARCHIVE=
# Strato may require INBOX.-prefixed folders (docs/VERIFY.md P2, A2):
# SEND_LEDGER_FOLDER=INBOX.MCP-Send-Ledger
# AUTH_STATE_FOLDER=INBOX.MCP-Auth-State
